#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$HOME/.local/share/chezmoi"

if [[ ! -e "$DOTFILES_DIR/scripts/nix/nix_rebuild.sh" ]]; then
    echo "❌ $DOTFILES_DIR not found or incomplete. Run install.sh from the dotfiles repo first." >&2
    exit 1
fi

exec "$DOTFILES_DIR/scripts/nix/nix_rebuild.sh" "$@"
