[settings]
python.uv_venv_auto = "create|source"

[env]
MISE_RUSTUP_HOME = "{{ .chezmoi.homeDir }}/.local/share/rustup"
MISE_CARGO_HOME = "{{ .chezmoi.homeDir }}/.local/share/cargo"

[tools]
# Language runtimes and mise-exclusive tools: always managed by mise,
# regardless of whether Homebrew is installed. CLI tools also available in
# Brewfile.tmpl live in config.no-brew.toml.tmpl instead, and are only
# loaded (via MISE_ENV=no-brew, see scripts/cli/mise_sync.sh) when Homebrew is not installed.
"github:devsy-org/devsy" = "latest"
bun = "latest"
go = "latest"
node = "latest"
nub = "latest"
python = "latest"
rust = "latest"