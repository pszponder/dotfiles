#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$HOME/.local/share/chezmoi"

if [[ ! -e "$DOTFILES_DIR/scripts/nix/nix_update.sh" || ! -e "$DOTFILES_DIR/scripts/nix/nix_rebuild.sh" ]]; then
    echo "❌ $DOTFILES_DIR not found or incomplete. Run install.sh from the dotfiles repo first." >&2
    exit 1
fi

"$DOTFILES_DIR/scripts/nix/nix_update.sh"

if ! git -C "$DOTFILES_DIR" diff --quiet -- nix/flake.lock; then
    echo "⏸️  nix/flake.lock changed. Commit it (see the reminder above), then run 'rebuild'." >&2
    exit 0
fi

exec "$DOTFILES_DIR/scripts/nix/nix_rebuild.sh"
