#!/bin/sh
set -eu

SCRIPT_DIR={{ .chezmoi.sourceDir | quote }}/../scripts/cli
. "$SCRIPT_DIR/../utils/utils_logging.sh"

MISE_BIN=$(command -v mise 2>/dev/null || true)
if [ -z "$MISE_BIN" ] && [ -x "$HOME/.local/bin/mise" ]; then
  MISE_BIN="$HOME/.local/bin/mise"
fi

for mise_path in /opt/homebrew/bin/mise /home/linuxbrew/.linuxbrew/bin/mise; do
  if [ -z "$MISE_BIN" ] && [ -x "$mise_path" ]; then
    MISE_BIN="$mise_path"
  fi
done

if [ -z "$MISE_BIN" ]; then
  log_error 'mise not available; run just mise-install first'
  exit 1
fi

MISE_CONFIG="$HOME/.config/mise/config.toml"
if [ ! -f "$MISE_CONFIG" ]; then
  log_error 'mise config not found; run chezmoi apply first'
  exit 1
fi

{{- if .is_omarchy }}
# Omarchy has its own mise environment. It is independent of Homebrew because
# Omarchy's system-owned CLI tools have already been removed from this profile.
export MISE_ENV=omarchy
MISE_ENV_CONFIG="$HOME/.config/mise/config.omarchy.toml"
{{- else }}
# Homebrew owns the shared CLI tools when it is installed. Without Homebrew,
# load the fallback mise environment containing those tools.
BREW_BIN=$(command -v brew 2>/dev/null || true)
for brew_path in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [ -z "$BREW_BIN" ] && [ -x "$brew_path" ]; then
    BREW_BIN="$brew_path"
  fi
done

if [ -n "$BREW_BIN" ]; then
  unset MISE_ENV
  MISE_ENV_CONFIG=""
else
  export MISE_ENV=no-brew
  MISE_ENV_CONFIG="$HOME/.config/mise/config.no-brew.toml"
fi
{{- end }}

"$MISE_BIN" trust "$MISE_CONFIG"

if [ -n "$MISE_ENV_CONFIG" ]; then
  if [ ! -f "$MISE_ENV_CONFIG" ]; then
    log_error "mise environment config not found: $MISE_ENV_CONFIG; run chezmoi apply first"
    exit 1
  fi
  "$MISE_BIN" trust "$MISE_ENV_CONFIG"
fi

"$MISE_BIN" install
"$MISE_BIN" reshim
